{
  "name": "ProjectSites — AI-native SaaS site builder",
  "short_name": "ProjectSites",
  "description": "Generated, branded, and live in minutes. AI builds and runs your business website on Cloudflare's edge.",
  "start_url": "/dashboard",
  "scope": "/",
  "id": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui", "standalone"],
  "orientation": "any",
  "theme_color": "#060610",
  "background_color": "#060610",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "developer"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/dashboard-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ProjectSites dashboard — bookings, quotes, jobs at a glance"
    },
    {
      "src": "screenshots/marketplace-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Live marketplace — quotes, crews on the map, instant payouts"
    },
    {
      "src": "screenshots/admin-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Super-admin console — audit log, tenant management"
    },
    {
      "src": "screenshots/dashboard-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile dashboard — every action a tap away"
    },
    {
      "src": "screenshots/marketplace-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Marketplace on mobile — book a crew in 30 seconds"
    },
    {
      "src": "screenshots/cmd-k-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cmd+K palette — search, jump, act"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "description": "Jump to the role-aware dashboard home.",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "icons/shortcut-dashboard.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "New booking",
      "short_name": "Book",
      "description": "Start a multi-day booking with instant quoting.",
      "url": "/dashboard/marketplace/new?source=pwa-shortcut",
      "icons": [{ "src": "icons/shortcut-book.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "New site",
      "short_name": "New site",
      "description": "Generate a new AI-built site from a one-line prompt.",
      "url": "/dashboard/sites/new?source=pwa-shortcut",
      "icons": [{ "src": "icons/shortcut-new-site.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/dashboard/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/plain"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/dashboard/files/open",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/avif": [".avif"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+projectsites",
      "url": "/dashboard/handle?url=%s"
    },
    {
      "protocol": "mailto",
      "url": "/dashboard/mail?to=%s"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  }
}
