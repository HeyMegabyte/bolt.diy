{
  "name": "Nango Connection Proxy",
  "nodes": [
    {
      "parameters": {
        "workflowId": "nango-proxy",
        "inputFields": [
          { "name": "integrationId", "type": "string", "required": true, "description": "Nango integration ID (e.g. 'github', 'stripe', 'hubspot')" },
          { "name": "connectionId", "type": "string", "required": true, "description": "Nango connection ID for the specific tenant/user" }
        ]
      },
      "id": "uuid-nango-input",
      "name": "Caller Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $vars.NANGO_BASE_URL || 'https://integrations.projectsites.dev' }}/connection/{{ $json.connectionId }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $vars.NANGO_SECRET_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "uuid-nango-fetch",
      "name": "Fetch Nango Connection",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "credentials": { "httpHeaderAuth": { "id": "NANGO_API_KEY", "name": "Nango API" } }
    },
    {
      "parameters": {
        "jsCode": "// Return the OAuth credentials from Nango\nconst connection = $input.first().json;\nif (!connection || connection.error) {\n  throw new Error('Nango connection not found or errored: ' + JSON.stringify(connection));\n}\n\nreturn {\n  access_token: connection.credentials?.access_token || connection.access_token,\n  refresh_token: connection.credentials?.refresh_token,\n  expires_at: connection.credentials?.expires_at,\n  connection_id: connection.connection_id,\n  provider_config_key: connection.provider_config_key,\n  metadata: connection.metadata || {}\n};"
      },
      "id": "uuid-nango-extract",
      "name": "Extract Token",
      "type": "n8n-nodes-base.code",
      "position": [650, 300]
    }
  ],
  "connections": {
    "Caller Input": { "main": [[ { "node": "Fetch Nango Connection", "type": "main", "index": 0 } ]] },
    "Fetch Nango Connection": { "main": [[ { "node": "Extract Token", "type": "main", "index": 0 } ]] }
  },
  "settings": { "callerPolicy": "workflowsFromSameOwner", "callerIds": "any" },
  "staticData": null,
  "tags": [{ "name": "nango" }, { "name": "oauth" }, { "name": "projectsites" }, { "name": "sub-workflow" }]
}
