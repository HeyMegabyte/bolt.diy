{
  "name": "ProjectSites Nightly Workflow Export",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 24 }]
        }
      },
      "id": "uuid-export-cron",
      "name": "Daily at 3am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true
      },
      "id": "uuid-export-list",
      "name": "List Workflows",
      "type": "n8n-nodes-base.n8n",
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Strip credential IDs from export for safe backup\nconst workflows = $input.first().json;\nconst sanitized = workflows.map(w => ({ name: w.name, id: w.id, active: w.active, updatedAt: w.updatedAt, tags: w.tags }));\nreturn sanitized;"
      },
      "id": "uuid-export-sanitize",
      "name": "Sanitize for Export",
      "type": "n8n-nodes-base.code",
      "position": [650, 300]
    }
  ],
  "connections": {
    "Daily at 3am": { "main": [[ { "node": "List Workflows", "type": "main", "index": 0 } ]] },
    "List Workflows": { "main": [[ { "node": "Sanitize for Export", "type": "main", "index": 0 } ]] }
  },
  "settings": { "callerPolicy": "workflowsFromSameOwner" },
  "staticData": null,
  "tags": [{ "name": "projectsites" }, { "name": "ops" }]
}
