    {
      "parameters": {
        "jsCode": "// Verify health endpoint returns ok\nconst response = $input.first().json;\nif (response.status === 'ok') {\n  return { success: true, message: 'ProjectSites health check passed' };\n}\nreturn { success: false, message: 'Health check failed', response: response };"
      },
      "id": "uuid-smoke-code",
      "name": "Validate Response",
      "type": "n8n-nodes-base.code",
      "position": [650, 300]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[ { "node": "Health Check", "type": "main", "index": 0 } ]] },
    "Health Check": { "main": [[ { "node": "Validate Response", "type": "main", "index": 0 } ]] }
  },
  "settings": { "callerPolicy": "workflowsFromSameOwner" },
  "staticData": null,
  "tags": [{ "name": "projectsites" }, { "name": "smoke-test" }]
