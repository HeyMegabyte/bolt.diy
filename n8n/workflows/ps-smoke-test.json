      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://projectsites.dev/health",
        "method": "GET",
        "options": {}
      },
      "id": "uuid-smoke-http",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
