{
  "name": "@projectsites/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for projectsites.dev — exposes the @projectsites/sdk surface so Claude Desktop / ChatGPT / Cursor / other agents can drive the platform.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "projectsites-mcp": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --experimental-strip-types ./src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@projectsites/sdk": "file:../sdk",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
