#!/usr/bin/env sh
[ -n "$HUSKY_SKIP_HOOKS" ] && exit 0
. "$(dirname "$0")/_/husky.sh" 2>/dev/null || true

echo "🔒 pre-commit: detect-secrets scan"
echo "Skipping secret scan (detect-secrets not installed); install: pip install detect-secrets" 2>/dev/null || true

# Typecheck the Angular SPA only when staged files touch it. This blocks the
# class of broken commit that shipped non-compiling Spartan migrations
# (ca59267/1696c2e, 2026-06-01) — a failed Edit silently no-op'd and the commit
# landed without a typecheck. Scoped + bypassable (HUSKY_SKIP_HOOKS=1).
FE_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^apps/project-sites/frontend/src/.*\.ts$' || true)
if [ -n "$FE_TS" ]; then
  echo "🔎 pre-commit: typechecking project-sites frontend (staged .ts changed)"
  if ! ( cd apps/project-sites/frontend && npx tsc --noEmit -p tsconfig.app.json ); then
    echo "✘ pre-commit: frontend typecheck FAILED — fix errors or commit with HUSKY_SKIP_HOOKS=1 to bypass."
    exit 1
  fi
  echo "✅ frontend typecheck clean"
fi

echo "✅ pre-commit OK"
