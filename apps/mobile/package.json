{
  "name": "@project-sites/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectSites admin SPA wrapped in Capacitor 6 + Ionic 8 for iOS and Android (Idea #47).",
  "scripts": {
    "start": "ng serve --port 4300",
    "build": "ng build --configuration production",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "ios:run": "npm run sync && cap run ios",
    "android:run": "npm run sync && cap run android",
    "lint": "eslint --config eslint.config.mjs src",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android"
  },
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@ionic/angular": "^8.4.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.14",
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
