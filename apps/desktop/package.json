{
  "name": "@project-sites/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri 2 desktop wrapper around the ProjectSites admin SPA (Idea #49).",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux-deb": "tauri build --bundles deb",
    "build:linux-appimage": "tauri build --bundles appimage",
    "lint": "eslint --config eslint.config.mjs src",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.5.0"
  }
}
