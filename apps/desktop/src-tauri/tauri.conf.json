{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "ProjectSites",
  "version": "0.1.0",
  "identifier": "dev.projectsites.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "tsc --watch",
    "beforeBuildCommand": "tsc"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProjectSites",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "url": "https://projectsites.dev/admin",
        "backgroundColor": "#060610",
        "titleBarStyle": "Overlay",
        "hiddenTitle": false,
        "transparent": false,
        "visible": true,
        "center": true
      }
    ],
    "macOSPrivateApi": false,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "ProjectSites"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Build, edit, and publish websites with AI.",
    "longDescription": "Native desktop wrapper around the ProjectSites admin SPA. Native menu bar, system tray for monitoring builds, offline-first editing queue, native notifications.",
    "publisher": "ProjectSites",
    "homepage": "https://projectsites.dev",
    "copyright": "© 2026 ProjectSites",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "projectsites.dev",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "wix": null,
      "nsis": null,
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": ["https://projectsites.dev/api/desktop/updates/{{target}}/{{current_version}}"],
      "dialog": true,
      "pubkey": ""
    }
  }
}
