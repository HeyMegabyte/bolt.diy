{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main ProjectSites desktop window.",
  "windows": ["main", "editor"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:allow-create-webview-window",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:allow-notify",
    "notification:default",
    "os:allow-platform",
    "os:allow-version",
    "deep-link:default"
  ]
}
