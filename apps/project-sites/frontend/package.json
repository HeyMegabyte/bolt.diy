{
  "name": "@project-sites/frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "check:alt-text": "node scripts/check-alt-text.mjs",
    "check:api-paths": "node scripts/check-api-paths.mjs",
    "validate:e2e-inventory": "node scripts/validate-e2e-inventory.mjs",
    "build:prod": "node scripts/check-alt-text.mjs && node scripts/check-api-paths.mjs && rm -rf .angular/cache && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "deploy:staging": "npm run build:prod && node scripts/deploy-r2.mjs staging",
    "deploy:production": "npm run build:prod && node scripts/deploy-r2.mjs production",
    "verify:production": "node scripts/verify-deploy.mjs https://projectsites.dev",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "ship:production": "npm run deploy:production && npm run verify:production && npm run test:e2e:prod",
    "upload-sourcemaps": "node scripts/upload-sourcemaps.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/service-worker": "^21.2.14",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@novu/js": "^3.16.0",
    "@sentry/angular": "^9.47.1",
    "@spartan-ng/brain": "^0.0.1-alpha.700",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/angular-table": "^8.21.4",
    "@twilio/voice-sdk": "^2.18.3",
    "@types/qrcode": "^1.5.6",
    "@uppy/core": "^5.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "ag-grid-angular": "^33.3.2",
    "ag-grid-community": "^33.3.2",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.1.7",
    "echarts": "^6.1.0",
    "jszip": "^3.10.1",
    "marked": "^12.0.2",
    "monaco-editor": "^0.55.0",
    "postcss": "^8.5.10",
    "posthog-js": "^1.376.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.14",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.58.2",
    "@types/dompurify": "^3.0.5",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "jasmine-core": "~5.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~5.9.3"
  }
}
