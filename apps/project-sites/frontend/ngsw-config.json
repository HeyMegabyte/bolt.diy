{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/admin/**/api/**",
    "!/v1/**",
    "!/webhooks/**",
    "!/auth/**",
    "!/**/*.*"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon-32x32.png",
          "/icon-*.png",
          "/logo-*.png",
          "/logo-*.svg",
          "/og-image.png",
          "/site.webmanifest",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "ps-api-cache",
      "urls": ["/api/sites", "/api/auth/me", "/api/billing/entitlements"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 64,
        "maxAge": "1h",
        "timeout": "3s"
      }
    },
    {
      "name": "ps-api-no-cache",
      "urls": [
        "/api/analytics/**",
        "/api/sites/*/snapshots",
        "/api/sites/*/form-submissions",
        "/api/audit-logs",
        "/api/sites/*/workflow",
        "/v1/forms/submit"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 0,
        "maxAge": "1s"
      }
    }
  ]
}
