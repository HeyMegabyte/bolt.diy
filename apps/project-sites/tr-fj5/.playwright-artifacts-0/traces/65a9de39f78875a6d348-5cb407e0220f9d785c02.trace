hero"},"\n      ",["DIV",{"class":"relative z-10 max-w-4xl mx-auto px-4 text-center"},"\n        ",["DIV",{"class":"inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-medium mb-8"},"\n          ",["SPAN",{"class":"w-1.5 h-1.5 rounded-full bg-primary"}],"\n          AI-powered website delivery for local businesses\n        "],"\n        ",["H1",{"class":"font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-light leading-tight mb-6"},"Your business website, already built and ready to claim."],"\n        ",["P",{"class":"text-text-secondary text-lg sm:text-xl max-w-2xl mx-auto mb-10"},"ProjectSites.dev finds businesses, researches what they do, generates polished website previews, and gives owners a fast path to claim, customize, and grow."],"\n        ",["P",{"class":"font-heading text-base sm:text-lg font-semibold mb-10"},["SPAN",{"class":"bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"},"We don't sell websites. We deliver them."]],"\n        ",["DIV",{"class":"relative max-w-xl mx-auto mb-8"},"\n          ",["DIV",{"class":"relative flex items-center bg-dark-card border border-white/10 rounded-2xl overflow-hidden"},"\n            ",["svg",{"class":"ml-4 text-text-secondary flex-shrink-0","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},"\n              ",["circle",{"cx":"11","cy":"11","r":"8"}],["path",{"d":"m21 21-4.3-4.3"}],"\n            "],"\n            ",["INPUT",{"__playwright_value_":"","type":"text","class":"flex-1 bg-transparent border-none outline-none text-light placeholder-text-secondary px-4 py-4 text-base","placeholder":"Search for your business...","readonly":"","aria-label":"Search for your business"}],"\n          "],"\n        "],"\n        ",["DIV",{"class":"flex flex-wrap items-center justify-center gap-4