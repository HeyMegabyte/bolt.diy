:"ov-step-num"},"3"],["DIV",{"_ngcontent-ng-c3257790837":"","class":"ov-step-body"},["DIV",{"_ngcontent-ng-c3257790837":"","class":"ov-step-h"},"Call your first endpoint"],["PRE",{"_ngcontent-ng-c3257790837":"","class":"ov-snippet"},["BUTTON",{"_ngcontent-ng-c3257790837":"","type":"button","aria-label":"Copy curl snippet","class":"ov-copy"},"Copy"],["CODE",{"_ngcontent-ng-c3257790837":""},"curl -sS https://projectsites.dev/api/auth/me \\\n  -H \"Authorization: Bearer $PS_TOKEN\""]]]]]],["SECTION",{"_ngcontent-ng-c3257790837":"","appreveal":"","class":"ov-card prose-docs"},["H2",{},"Authentication"],"\n",["P",{},"Every authenticated endpoint accepts a bearer token:"],"\n",["PRE",{},["SPAN",{"class":"code-lang","aria-hidden":"true"},"http"],"Copy",["CODE",{},"Authorization: Bearer ps_sk_live_…\n"]],"\n",["P",{},"Tokens come from one of two places:"],"\n",["UL",{},["LI",{},["STRONG",{},"Browser sessions"]," — issued by magic-link or Google OAuth and stored in ",["CODE",{},"localStorage"],". The Docs explorer below uses this automatically."],["LI",{},["STRONG",{},"Programmatic API keys"]," — generate dedicated, scoped keys at ",["A",{"href":"/admin/user#api-keys","target":"_blank","rel":"noopener noreferrer"},"/admin/user#api-keys"],". Use these for CLIs, CI jobs, and server-to-server integrations."]],"\n",["H2",{},"Rate limits"],"\n",["P",{},"The API is rate-limited to ",["STRONG",{},"60 requests per minute per token"]," by default. Endpoints with custom budgets advertise them in their detail card. Overage returns:"],"\n",["PRE",{},["SPAN",{"class":"code-lang","aria-hidden":"true"},"http"],"Copy",["CODE",{},"HTTP/1.1 429 Too Many Requests\nRetry-After: 18\n"]],"\n",["P",{},"Honor the ",["CODE",{},"Retry-After"]," value — it is seconds (integer), not a date."],"\n",["H2",{},"Response shape"],"\n",["P",{},"Every successful response is JSON with a ",["CODE",{},"data"]," key and an optional ",["CODE",{},"meta"]," block:"],"\n",["PRE",{},["SPAN",{"class":"code-lang","aria-hidden":"true"},"json"],"Copy",["CODE",{},"{ \"data\": { \"id\": \"uuid\" }, \"meta\": { \"request_id\": \"req_01HW…\" } }\n"]],"\n",["P",{},"Every error is JSON with an ",["CODE",{},"error"]," key. The shape never changes:"],"\n",["PRE",{},["SPAN",{"class":"code-lang","aria-hidden":"true"},"json"],"Copy",["CODE",{},"{ \"error\": { \"code\": \"NOT_FOUND\", \"message\": \"Site not found\", \"request_id\": \"req_01HW…\" } }\n"]],"\n",["P",{},"Every response carries an ",["CODE",{},"X-Request-ID"]," header. Quote it when filing support tickets."],"\n",["H2",{},"Versioning"],"\n",["P",{},"The current major version is ",["STRONG",{},"v1"],". Routes prefixed ",["CODE",{},"/api/"]," follow the stable contract; additive changes (new optional fields, new endpoints, new ",["CODE",{},"meta"]," keys) ship without a version bump. Breaking changes ship behind ",["CODE",{},"/api/v2/"]," and run side-by-side for at least 12 months before the v1 deprecation date."],"\n",["H2",{},"Conventions"],"\n",["UL",{},["LI",{},["STRONG",{},"IDs"]," are UUID v4 strings. Slugs are kebab-case ASCII."],["LI",{},["STRONG",{},"Timestamps"]," are ISO-8601 UTC."],["LI",{},["STRONG",{},"Idempotency"]," — ",["CODE",{},"POST"]," and ",["CODE",{},"DELETE"]," accept an ",["CODE",{},"Idempotency-Key"]," header (any UUID); the same key replays the original response for 24 hours."]]]]]]]]],["BUTTON",{"_ngcontent-ng-c252089845":"","class":"jump-back-fab ng-star-inserted","aria-label":"Back to Logs"},[[165,90]],["SPAN",{"_ngcontent-ng-c252089845":"","class":"jump-back-label"},"Logs"]],[[165,94]]]],[[218,876]],[[218,877]],[[218,878]]]]],[[222,278]],[[222,279]],[[222,280]],[[222,281]],[[222,282]],[[222,283]],[[222,284]],[[222,285]],[[222,286]],[[222,287]],[[222,288]],[[222,289]],[[222,290]],[[222,291]],[[222,292]],["DIV",{"class":"cursor-follower visible","style":"left: 115px; top: 579.944px;"}],["DIV",{"class":"cdk-overlay-container"},[[218,884]],[[218,886]],[[218,888]],[[218,890]],[[218,892]],[[218,894]],[[218,8