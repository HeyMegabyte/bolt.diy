# Directus — directus.projectsites.dev
# Copy to .env and fill in real values. Never commit .env.

# Directus config
PUBLIC_URL=https://directus.projectsites.dev
HOST=0.0.0.0
PORT=8055
SECRET=<generate: openssl rand -base64 48>
ADMIN_EMAIL=<your-email>
ADMIN_PASSWORD=<generate: openssl rand -base64 24>

# Postgres (Neon)
DB_CLIENT=pg
DB_CONNECTION_STRING=postgresql://user:password@host/database?sslmode=require

# Redis (Upstash)
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true
CACHE_STORE=redis
REDIS=rediss://default:password@endpoint.upstash.io:6379

# Storage (Cloudflare R2 — S3-compatible)
STORAGE_LOCATIONS=r2
STORAGE_R2_DRIVER=s3
STORAGE_R2_BUCKET=projectsites-directus-assets
STORAGE_R2_REGION=auto
STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_R2_KEY=<r2-access-key-id>
STORAGE_R2_SECRET=<r2-secret-access-key>
