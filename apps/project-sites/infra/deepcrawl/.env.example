# Deepcrawl Dashboard — required secrets for production
# Copy to .dev.vars and fill in real values. Never commit .dev.vars.

# Required
BETTER_AUTH_SECRET=           # openssl rand -base64 32
DATABASE_URL=                 # Neon Postgres connection string for auth sessions
NEXT_PUBLIC_APP_URL=https://deepcrawl.projectsites.dev
NEXT_PUBLIC_DEEPCRAWL_API_URL=https://api.deepcrawl.projectsites.dev
BETTER_AUTH_URL=https://auth.deepcrawl.projectsites.dev
AUTH_COOKIE_DOMAIN=projectsites.dev
AUTH_MODE=better-auth
NEXT_PUBLIC_BRAND_NAME=Deepcrawl

# Optional — OAuth (GitHub/Google sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — email (magic link / password reset)
RESEND_API_KEY=
FROM_EMAIL=

# API Worker (v0) secrets — set on the v0 worker via wrangler secret put
# JWT_SECRET=                 # openssl rand -base64 32
# BETTER_AUTH_SECRET=         # same as dashboard
