# SearXNG environment variables
# Copy to .env and fill in real values. Never commit .env.

# SearXNG secret key — generate with: openssl rand -base64 32
SEARXNG_SECRET=

# Upstash Redis-compatible URL for limiter/bot-detection
# Format: redis://:password@hostname:port
# Create at https://console.upstash.com/redis
SEARXNG_VALKEY_URL=

# Base URL (set in wrangler.toml vars, override here for local dev)
SEARXNG_BASE_URL=https://search.projectsites.dev/
