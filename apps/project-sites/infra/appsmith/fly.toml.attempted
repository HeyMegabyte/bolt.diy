# Appsmith — internal tools builder for ProjectSites.dev
# Deployed on Fly.io with persistent volume (CF Container ephemeral disk
# cannot safely host embedded MongoDB/PostgreSQL/Redis for production).
# Cloudflare remains the front door: DNS, TLS, WAF, proxy.
#
# Pinned to appsmith/appsmith-ee:v2.1.1 — never use :latest in production.
#
# Cost: ~$91/mo (8 GB performance-2 VM + 50 GB persistent volume)
#       ≈ $0.13/hr. Appsmith needs 8GB for embedded MongoDB + PostgreSQL + Redis.
#       Externalize services to reduce to shared-2 (~$32/mo).

app = "projectsites-appsmith"
primary_region = "ewr"

[build]
dockerfile = "Dockerfile"

[[mounts]]
source = "appsmith_data"
destination = "/appsmith-stacks"

[http_service]
internal_port = 80
force_https = true
auto_stop_machines = false
auto_start_machines = true
min_machines_running = 1

[[http_service.checks]]
path = "/health"
method = "GET"
interval = "15s"
timeout = "5s"
grace_period = "120s"

[env]
APPSMITH_BASE_URL = "https://appsmith.projectsites.dev"

[[vm]]
memory = "8gb"
cpu_kind = "performance"
cpus = 2
