# ─── Required (set via `flyctl secrets set`) ──────────────────
# APPSMITH_ENCRYPTION_PASSWORD — openssl rand -base64 32 (encrypts app credentials at rest)
# APPSMITH_ENCRYPTION_SALT     — openssl rand -base64 32 (encrypts app credentials at rest)
# APPSMITH_SUPERVISOR_PASSWORD — strong initial admin password (change after first login)
#
# ─── Base URL ──────────────────────────────────────────────────
APPSMITH_BASE_URL=https://appsmith.projectsites.dev
#
# ─── Admin ─────────────────────────────────────────────────────
APPSMITH_SIGNUP_DISABLED=false
# After first admin bootstrap, set APPSMITH_SIGNUP_DISABLED=true to lock down.
APPSMITH_ADMIN_EMAILS=
# Comma-separated email allowlist. Set after bootstrap.
#
# ─── Email (SES SMTP) ──────────────────────────────────────────
# APPSMITH_MAIL_ENABLED=false
# APPSMITH_MAIL_FROM=no-reply@projectsites.dev
# APPSMITH_MAIL_HOST=<ses-smtp-endpoint>
# APPSMITH_MAIL_PORT=587
# APPSMITH_MAIL_USERNAME=<ses-smtp-username>
# APPSMITH_MAIL_PASSWORD=<ses-smtp-password>
# APPSMITH_MAIL_SMTP_TLS_ENABLED=true
#
# ─── External MongoDB (unset to use embedded) ───────────────────
# APPSMITH_MONGODB_URI=mongodb://<host>:27017/appsmith
#
# ─── External Redis (unset to use embedded) ─────────────────────
# APPSMITH_REDIS_URL=redis://<host>:6379
#
# ─── External PostgreSQL (Neon — unset to use embedded) ─────────
# APPSMITH_DB_URL=postgresql://<user>:<pass>@<host>/appsmith?sslmode=require
# SQL_TLS_ENABLED=true
#
# ─── OAuth / SSO (optional) ─────────────────────────────────────
# APPSMITH_OAUTH2_GOOGLE_CLIENT_ID=
# APPSMITH_OAUTH2_GOOGLE_CLIENT_SECRET=
# APPSMITH_OAUTH2_GITHUB_CLIENT_ID=
# APPSMITH_OAUTH2_GITHUB_CLIENT_SECRET=
