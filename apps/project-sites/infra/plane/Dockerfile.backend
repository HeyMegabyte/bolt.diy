# Plane backend (Django) — api (gunicorn :8000) + celery worker + celery beat under supervisord
# in ONE CF Container DO. Talks to Neon/Upstash/CloudAMQP/R2. Pin the tag to a known-good Plane
# CE release before prod + verify the bin/ entrypoint names match this version.
FROM makeplane/plane-backend:stable
USER root
RUN (apt-get update && apt-get install -y --no-install-recommends supervisor && rm -rf /var/lib/apt/lists/*) \
 || (apk add --no-cache supervisor)
COPY supervisord.conf /etc/supervisor/conf.d/plane.conf
COPY start.sh /start.sh
RUN chmod +x /start.sh
EXPOSE 8000
CMD ["/start.sh"]
