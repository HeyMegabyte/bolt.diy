# Plane env — pm.megabyte.space. Values are pulled from the chezmoi secret store at deploy
# time (get-secret KEY); this file is the TEMPLATE (no real secrets committed).

# ── Core ──
SECRET_KEY=$(get-secret PLANE_SECRET_KEY)         # generated openssl rand -hex 32
WEB_URL=https://pm.megabyte.space
DEBUG=0
CORS_ALLOWED_ORIGINS=https://pm.megabyte.space

# ── Postgres (Neon — direct endpoint, DB `plane` in project n8n/dawn-bread-71972871) ──
DATABASE_URL=$(get-secret PLANE_DATABASE_URL)
# (Plane also accepts split vars: PGHOST/PGUSER/PGPASSWORD/PGDATABASE=plane/PGPORT=5432)

# ── Redis cache (Upstash — sweet-ibex-138916.upstash.io, TLS) ──
REDIS_URL=$(get-secret PLANE_REDIS_URL)

# ── RabbitMQ broker (CloudAMQP — Little Lemur, AWS us-east-1) ──
AMQP_URL=$(get-secret PLANE_AMQP_URL)
# Plane reads AMQP_URL for the Celery broker. (Split vars RABBITMQ_HOST/USER/PASSWORD/VHOST
# also work — vhost = exfiahsa, host = moose.rmq.cloudamqp.com.)

# ── Object storage (Cloudflare R2, bucket plane-media) ──
USE_MINIO=0
AWS_REGION=auto
AWS_ACCESS_KEY_ID=$(get-secret PLANE_R2_ACCESS_KEY_ID)         # ⚠ mint in R2 dashboard
AWS_SECRET_ACCESS_KEY=$(get-secret PLANE_R2_SECRET_ACCESS_KEY) # ⚠ mint in R2 dashboard
AWS_S3_ENDPOINT_URL=https://84fa0d1b16ff8086dd958c468ce7fd59.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=plane-media
FILE_SIZE_LIMIT=5242880

# ── Frontends (per-app) ──
NEXT_PUBLIC_API_BASE_URL=https://pm.megabyte.space
NEXT_PUBLIC_DEPLOY_URL=https://pm.megabyte.space/spaces

# ── Workers ──
GUNICORN_WORKERS=2
# Celery worker + beat run as separate Fly process groups off the same backend image.

# ── Email (optional — reuse SES like the other infra apps) ──
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com  EMAIL_PORT=587  EMAIL_USE_TLS=1
# EMAIL_HOST_USER=<ses smtp user>  EMAIL_HOST_PASSWORD=<ses smtp pass>
# EMAIL_FROM="Megabyte Labs PM <noreply@projectsites.dev>"
