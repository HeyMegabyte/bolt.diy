app = "projectsites-maxun-browser"
primary_region = "ewr"

[build]
  image = "getmaxun/maxun-browser:latest"

[env]
  BROWSER_WS_PORT = "3001"
  BROWSER_HEALTH_PORT = "3002"
  NODE_ENV = "production"

[[services]]
  protocol = "tcp"
  internal_port = 3002

  [[services.ports]]
    port = 3002

[[vm]]
  memory = "2gb"
  cpu_kind = "shared"
  cpus = 2
