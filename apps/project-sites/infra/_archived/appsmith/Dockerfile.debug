# Wrapper around Appsmith CE to capture entrypoint debug output.
# The base image crashes with exit_code=2 within ~24s on Fly Firecracker VMs.
# This wrapper pipes entrypoint stdout/stderr to a log for diagnosis.
FROM appsmith/appsmith-ce:v2.1

# Override entrypoint to capture debug output before running the real entrypoint
COPY entrypoint-debug.sh /entrypoint-debug.sh
RUN chmod +x /entrypoint-debug.sh

ENTRYPOINT ["/entrypoint-debug.sh"]
