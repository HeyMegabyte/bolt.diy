# ── Medusa Production Environment ──
NODE_ENV=production
PORT=9000

# ── Neon Postgres ──
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/medusa?sslmode=require

# ── Upstash Redis ──
REDIS_URL=rediss://default:password@host.upstash.io:6379
# Optional per-function Redis DBs (auto-derived from REDIS_URL if unset):
# CACHE_REDIS_URL=rediss://default:password@host.upstash.io:6379/1
# EVENTS_REDIS_URL=rediss://default:password@host.upstash.io:6379/2
# WORKFLOW_REDIS_URL=rediss://default:password@host.upstash.io:6379/3
# LOCKING_REDIS_URL=rediss://default:password@host.upstash.io:6379/4

# ── Auth Secrets (generate with: openssl rand -hex 32) ──
JWT_SECRET=
COOKIE_SECRET=

# ── Server mode ──
MEDUSA_WORKER_MODE=server
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=https://medusa.projectsites.dev

# ── CORS ──
ADMIN_CORS=https://medusa.projectsites.dev
AUTH_CORS=https://medusa.projectsites.dev
STORE_CORS=https://medusa.projectsites.dev

# ── Cloudflare R2 (S3-compatible) ──
S3_FILE_URL=https://medusa.projectsites.dev/uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=medusa-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── Stripe ──
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Admin User (for first-time setup) ──
MEDUSA_ADMIN_EMAIL=admin@projectsites.dev
MEDUSA_ADMIN_PASSWORD=
