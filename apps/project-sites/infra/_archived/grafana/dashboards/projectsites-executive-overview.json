    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Site Count (Total / Active)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "refId": "A",
            "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
            "scenarioId": "csv_content",
            "csvContent": "time,total,active\n1,0,0"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
            "color": {"mode": "thresholds"}
          }
        },
        "options": {"textMode": "value_and_name", "colorMode": "value"},
        "description": "TODO: Wire to D1 sites table query. Currently placeholder."
      },
