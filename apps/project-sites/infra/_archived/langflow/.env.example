# Langflow — environment variables (placeholders only; never commit real values)
# See docs/deploy/langflow.projectsites.dev.md for full deployment guide.

# ── Required ──
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=False
LANGFLOW_OPEN_BROWSER=False
LANGFLOW_LOG_LEVEL=info
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=<generate: openssl rand -base64 16>
LANGFLOW_SECRET_KEY=<generate: openssl rand -base64 32>
LANGFLOW_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Optional: multi-worker mode (requires Redis) ──
# LANGFLOW_WORKERS=3
# LANGFLOW_JOB_QUEUE_TYPE=redis
# LANGFLOW_REDIS_QUEUE_URL=rediss://default:password@host:6379

# ── Optional: S3-compatible storage (R2) ──
# LANGFLOW_STORAGE_TYPE=s3
# LANGFLOW_OBJECT_STORAGE_BUCKET_NAME=langflow-storage
# LANGFLOW_OBJECT_STORAGE_PREFIX=langflow/
# AWS_ACCESS_KEY_ID=<r2-access-key>
# AWS_SECRET_ACCESS_KEY=<r2-secret-key>
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT_URL_S3=https://<account>.r2.cloudflarestorage.com
