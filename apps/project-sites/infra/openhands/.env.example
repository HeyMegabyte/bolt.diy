# OpenHands Agent Canvas — ProjectSites.dev
# Internal coding-agent console at openhands.projectsites.dev

# ── Worker secrets (set via wrangler secret put) ────────────────────────────
# Admin login password
OPENHANDS_ADMIN_PASSWORD=

# Session signing secret (auto-generate: openssl rand -base64 48)
OPENHANDS_SESSION_SECRET=

# Origin secret shared between Worker and Fly.io origin
# (auto-generate: openssl rand -base64 48)
OPENHANDS_ORIGIN_SECRET=

# ── Origin env vars (set via flyctl secrets) ─────────────────────────────────
# Same as OPENHANDS_ORIGIN_SECRET above
# OPENHANDS_ORIGIN_SECRET=

# Auto-generated on first boot if not set
# LOCAL_BACKEND_API_KEY=
# OH_SECRET_KEY=

# ── LLM provider API keys (set via flyctl secrets) ───────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
