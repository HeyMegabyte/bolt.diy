# ── Dify @ dify.projectsites.dev — Environment Variables ──────────────────
# Backing services: Neon (Postgres) · Upstash (Redis) · Weaviate Cloud · R2 (storage)
# Compute: Fly.io (api + worker + beat + web + sandbox + plugin daemon)
# Front door: Cloudflare Worker (reverse proxy)
#
# Copy to .env and populate before: flyctl deploy / flyctl secrets set

# ── Core ───────────────────────────────────────────────────────────────────
SECRET_KEY=                            # openssl rand -base64 42
CONSOLE_API_URL=https://dify.projectsites.dev/console/api
CONSOLE_WEB_URL=https://dify.projectsites.dev
SERVICE_API_URL=https://dify.projectsites.dev/api
APP_API_URL=https://dify.projectsites.dev/v1
APP_WEB_URL=https://dify.projectsites.dev
DEPLOY_ENV=PRODUCTION
MODE=api                               # overridden per process: api | worker | beat

# ── Database (Neon Postgres) ───────────────────────────────────────────────
DB_TYPE=postgresql
DB_HOST=                               # Neon hostname (ep-*.us-east-1.aws.neon.tech)
DB_PORT=5432
DB_USERNAME=                           # Neon database owner
DB_PASSWORD=                           # Neon database password
DB_DATABASE=dify

# ── Redis (Upstash) ────────────────────────────────────────────────────────
REDIS_HOST=                            # Upstash Redis hostname
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=                        # Upstash Redis password
REDIS_USE_SSL=true

# ── Storage (Cloudflare R2, S3-compatible) ─────────────────────────────────
STORAGE_TYPE=s3
S3_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
S3_BUCKET_NAME=projectsites-dify
S3_ACCESS_KEY=                         # R2 Access Key ID
S3_SECRET_KEY=                         # R2 Secret Access Key
S3_REGION=auto
S3_ADDRESS_STYLE=path

# ── Vector Store (Weaviate Cloud) ──────────────────────────────────────────
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=                     # https://{cluster-id}.weaviate.network
WEAVIATE_API_KEY=                      # Weaviate Cloud API key
WEAVIATE_BATCH_SIZE=100

# ── Code Execution Sandbox ─────────────────────────────────────────────────
CODE_EXECUTION_ENDPOINT=http://dify-sandbox.internal:8194
CODE_EXECUTION_API_KEY=dify-sandbox

# ── Plugin Daemon ──────────────────────────────────────────────────────────
PLUGIN_DAEMON_URL=http://dify-plugin.internal:5003
PLUGIN_DAEMON_KEY=                     # openssl rand -base64 32

# ── SSRF Proxy (disabled — Fly private network) ────────────────────────────
SSRF_PROXY_HTTP_URL=
SSRF_PROXY_HTTPS_URL=

# ── Email (Resend) ─────────────────────────────────────────────────────────
MAIL_TYPE=resend
MAIL_DEFAULT_SENDER=                   # e.g. Dify <noreply@projectsites.dev>
RESEND_API_KEY=                        # Resend API key

# ── Sentry (optional) ──────────────────────────────────────────────────────
# SENTRY_DSN=

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=%(asctime)s.%(msecs)03d %(levelname)s [%(threadName)s] [%(filename)s:%(lineno)d] - %(message)s
LOG_DATEFORMAT=%Y-%m-%d %H:%M:%S

# ── Initial Admin User ─────────────────────────────────────────────────────
# Created manually after first deploy:
#   flyctl ssh console -a dify --command "flask create-account"
INIT_PASSWORD=                         # Temp admin password (change after first login)
