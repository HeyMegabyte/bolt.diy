# Onyx deployment — onyx.projectsites.dev
# Backing services: Neon Postgres + Upstash Redis, deployed on Fly.io
#
# Copy to .env and fill in real values. NEVER commit .env.

# ── Auth ──────────────────────────────────────────────────────────────────
AUTH_TYPE=basic
USER_AUTH_SECRET=openssl rand -hex 32

# ── Postgres (Neon pooled) ────────────────────────────────────────────────
POSTGRES_HOST=ep-round-wildflower-aigybxdk-pooler.c-4.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=projectsites_onyx
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=<from get-secret or Neon dashboard>

# ── Redis (Upstash) ───────────────────────────────────────────────────────
# Onyx uses REDIS_HOST (not REDIS_URL). Password goes in REDIS_PASSWORD.
REDIS_HOST=assuring-cat-155637.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<from get-secret or Upstash console>
REDIS_SSL=true

# ── Vector DB (Onyx Lite skips this) ──────────────────────────────────────
DISABLE_VECTOR_DB=true

# ── File storage (use Postgres for Lite mode) ─────────────────────────────
FILE_STORE_BACKEND=postgres

# ── LLM (optional for login; required for chat/RAG) ───────────────────────
# GEN_AI_API_KEY=sk-...
# GEN_AI_API_ENDPOINT=https://llm.projectsites.dev

# ── Internal routing (web → API) ──────────────────────────────────────────
INTERNAL_URL=http://127.0.0.1:8081

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
