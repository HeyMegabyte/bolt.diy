# Onyx deployment — onyx.projectsites.dev
# Backing services: Neon Postgres + Upstash Redis + Cloudflare R2
# Deployed on Fly.io

# ── Auth ──────────────────────────────────────────────────────────────────
AUTH_TYPE=basic
USER_AUTH_SECRET=openssl rand -hex 32

# ── Postgres (Neon direct, not pooled — needed for DDL migrations) ───────
POSTGRES_HOST=ep-round-wildflower-aigybxdk.c-4.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=projectsites_onyx
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=<from get-secret or Neon dashboard>

# ── Redis (Upstash) ───────────────────────────────────────────────────────
REDIS_HOST=assuring-cat-155637.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<from get-secret or Upstash console>
REDIS_SSL=true

# ── Vector DB (Onyx Lite) ─────────────────────────────────────────────────
DISABLE_VECTOR_DB=true

# ── File storage (Cloudflare R2 S3-compatible) ────────────────────────────
FILE_STORE_BACKEND=s3
S3_ENDPOINT_URL=https://84fa0d1b16ff8086dd958c468ce7fd59.r2.cloudflarestorage.com
S3_BUCKET_NAME=onyx-projectsites
S3_REGION=auto
S3_ACCESS_KEY_ID=<create at https://dash.cloudflare.com/84fa0d1b16ff8086dd958c468ce7fd59/r2/onyx-projectsites/settings/tokens>
S3_SECRET_ACCESS_KEY=<same URL>

# ── LLM ───────────────────────────────────────────────────────────────────
GEN_AI_API_KEY=sk-73f39bbc9680d3d78a0f181435728b595ec23c74d70497c0
GEN_AI_API_ENDPOINT=https://llm.projectsites.dev

# ── MCP Server ────────────────────────────────────────────────────────────
MCP_SERVER_ENABLED=true

# ── Internal routing (web → API) ──────────────────────────────────────────
INTERNAL_URL=http://127.0.0.1:8081

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
