# ==============================================
# Checkmate — ProjectSites.dev monitoring control plane
# ==============================================
# Copy relevant values to Fly.io secrets (flyctl secrets set KEY=VALUE)
# NEVER commit real secrets to this file.

# Server Configuration
# --------------------
NODE_ENV=production
LOG_LEVEL=info

# Database (MongoDB — runs locally on the same Fly machine)
# ----------------------------------------------------------
DB_CONNECTION_STRING=mongodb://127.0.0.1:27017/uptime_db

# Queue Configuration (in-process — no external Redis required)
# -------------------------------------------------------------
QUEUE_MODE=primary
QUEUE_PRIMARY_PROCESSES=true

# JWT Authentication (REQUIRED — set via flyctl secrets)
# ------------------------------------------------------
# Generate: openssl rand -hex 64
JWT_SECRET=<generate-with-openssl-rand-hex-64>
TOKEN_TTL=30d

# Client Configuration (REQUIRED)
# -------------------------------
CLIENT_HOST=https://monitor.projectsites.dev

# Optional
# --------
ORIGIN=monitor.projectsites.dev
STATUS_PAGE_THEMES_ENABLED=true

# Email (optional — configure after SMTP credentials are available)
# ----------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@projectsites.dev
