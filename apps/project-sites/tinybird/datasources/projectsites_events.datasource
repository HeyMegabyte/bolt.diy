# projectsites_events — the unified event-bus landing table.
#
# Every ProjectSitesEvent the worker emits (14 golden-path types, all tenants)
# is drained from the durable D1 outbox to this datasource by the */5 cron via
# services/outbox_dispatch.ts -> ingestTinybirdEvent(). The column set below is
# the SINGLE SOURCE OF TRUTH for that NDJSON payload — keep it in lockstep with
# the object built in outbox_dispatch.dispatchOutboxEvent() (OUTBOX_TINYBIRD_DATASOURCE).
#
# Ingest endpoint: POST /v0/events?name=projectsites_events   (NDJSON, one event per line)
# Deploy:          tb push datasources/projectsites_events.datasource   (or `tb deploy`)

SCHEMA >
    `site_id` String,
    `tenant_id` String,
    `event` LowCardinality(String),
    `timestamp` DateTime64(3),
    `event_id` String,
    `trace_id` String,
    `producer` LowCardinality(String),
    `payload` String `json:$.payload` DEFAULT '{}'

# `payload` is the JSON-stringified event `data` (slug, version, source, leadId,
# previewUrl, …) — the high-cardinality activation signal. Stored as a String so
# pipes slice it with JSONExtract* (see pipes/site_publishes_by_source.pipe)
# without a fixed sub-schema. DEFAULT '{}' keeps rows ingested before this column
# existed valid. Keep in lockstep with dispatchOutboxEvent()'s Tinybird object.

# ReplacingMergeTree (not plain MergeTree) so a duplicate ingest of the same
# event_id collapses on merge. The outbox dispatcher re-sends ALL targets when a
# row retries after a PARTIAL failure (e.g. Tinybird ok but Hatchet failed), so
# a previously-delivered event can be ingested twice — event_id in the sorting
# key + Replacing makes that storage-idempotent. Queries dedup explicitly via
# count(DISTINCT event_id) (see events_by_tenant_daily.pipe) for exactly-once
# BEFORE the background merge runs.
ENGINE "ReplacingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(timestamp)"
ENGINE_SORTING_KEY "tenant_id, timestamp, event, event_id"
