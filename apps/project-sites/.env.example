# ── Integrations — API keys ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_API_KEY=xxx
TWILIO_API_SECRET=xxx
TWILIO_TWIML_APP_SID=APxxx
DEEPGRAM_API_KEY=xxx
ELEVENLABS_API_KEY=xxx
BROWSERBASE_API_KEY=xxx
BROWSERBASE_PROJECT_ID=xxx
BRANDFETCH_API_KEY=xxx
LOGODEV_TOKEN=xxx
ABSTRACT_GEO_API_KEY=xxx
FOURSQUARE_API_KEY=xxx
TRIPADVISOR_API_KEY=xxx
WHAT3WORDS_API_KEY=xxx
YELP_API_KEY=xxx
YOUTUBE_API_KEY=xxx
MAPBOX_ACCESS_TOKEN=xxx
WHOISXML_API_KEY=xxx
GODADDY_API_KEY=xxx
GODADDY_API_SECRET=xxx
OPENSRS_API_KEY=xxx
OPENSRS_USERNAME=xxx
OPENSRS_ENV=sandbox
HUNTER_API_KEY=xxx
TRUSTPILOT_API_KEY=xxx
GTMETRIX_API_KEY=xxx
PAGESPEED_API_KEY=xxx
CHATWOOT_API_KEY=xxx
CHATWOOT_API_URL=https://app.chatwoot.com

# ── CF Access (service-to-service auth) ──────────────────────────────────────
CF_ACCESS_CLIENT_ID=xxx
CF_ACCESS_CLIENT_SECRET=xxx

# ── Runtime / Environment ─────────────────────────────────────────────────────
ENVIRONMENT=development
RESEARCH_MODEL=llama-3.1-8b-instruct
METERING_PROVIDER=stripe
TEMPLATE_CACHE_TTL=3600
AB_MODEL_SPLIT=50

# ── PostHog ───────────────────────────────────────────────────────────────────
# Primary product analytics. Ingestion host: us.i.posthog.com (NOT app.posthog.com)
# POSTHOG_API_KEY, POSTHOG_PUBLIC_KEY, POSTHOG_HOST defined in Observability above
POSTHOG_PROJECT_ID=210890
POSTHOG_PERSONAL_API_KEY=phx_xxx

# ── Axiom ─────────────────────────────────────────────────────────────────────
# Primary structured logs. UI at logs.projectsites.dev
AXIOM_API_KEY=xaat-xxx
AXIOM_DATASET=projectsites-logs
AXIOM_ORG_ID=xxx

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Correlation/transport layer. [observability] enabled=true in wrangler.toml for
# zero-config Workers Tracing; these vars control manual OTLP export to Axiom.
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-xxx,X-Axiom-Dataset=projectsites-traces
OTEL_SERVICE_NAME=project-sites-worker

# ── ClickHouse ────────────────────────────────────────────────────────────────
# High-volume analytics warehouse on Fly.io. HTTP interface (port 8123).
# Tinybird is the documented managed alternative — see docs/analytics/clickhouse.md
CLICKHOUSE_HOST=https://clickhouse.internal:8123
CLICKHOUSE_DATABASE=projectsites
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=xxx
CLICKHOUSE_PORT=8123

# ── Fly.io ────────────────────────────────────────────────────────────────────
# Fly hosts ClickHouse (volume/multi-proc) and Chatwoot (multi-proc).
# Default heavy/stateful host = CF Containers + Neon + Upstash; Fly only when CF can't.
FLY_API_TOKEN=xxx
FLY_ORG=personal
FLY_REGION=iad

# ── Chatwoot ──────────────────────────────────────────────────────────────────
# Customer support at support.projectsites.dev (Fly.io)
# CHATWOOT_API_KEY and CHATWOOT_API_URL defined in Integrations above
CHATWOOT_WEBHOOK_TOKEN=xxx
CHATWOOT_INBOX_ID=1
CHATWOOT_ACCOUNT_ID=1

# ── Postiz ────────────────────────────────────────────────────────────────────
# Social scheduling at social.projectsites.dev (CF Container, AGPL-3.0 ISOLATED)
# DO NOT import Postiz code into the main Worker — HTTP API only.
# Transition service while ProjectSites-native Social is built.
POSTIZ_URL=https://social.projectsites.dev
POSTIZ_API_KEY=xxx
POSTIZ_SECRET=xxx

# ── Native Social ─────────────────────────────────────────────────────────────
# ProjectSites-native Social (Hono + CF Workflows/Queues/Durable Objects).
# Long-term social product. NOT dependent on Postiz runtime. NOT Temporal.
SOCIAL_SIGNING_KEY=xxx
# SOCIAL_DO_NAMESPACE and SOCIAL_QUEUE_NAME are bindings — set in wrangler.toml

# ── R2 Social ─────────────────────────────────────────────────────────────────
# R2 bucket for social media assets (images, videos queued for publish)
# SOCIAL_R2_BUCKET is a binding — set in wrangler.toml
SOCIAL_R2_PUBLIC_URL=https://social-assets.projectsites.dev
