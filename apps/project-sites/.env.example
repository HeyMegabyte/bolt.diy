MAILCHIMP_CLIENT_ID=xxx
MAILCHIMP_CLIENT_SECRET=xxx
MAILCHIMP_OAUTH_CLIENT_ID=xxx
MAILCHIMP_OAUTH_CLIENT_SECRET=xxx
CALENDLY_OAUTH_CLIENT_ID=xxx
CALENDLY_OAUTH_CLIENT_SECRET=xxx
CALENDLY_WEBHOOK_SIGNING_KEY=xxx
PAGERDUTY_OAUTH_CLIENT_ID=xxx
PAGERDUTY_OAUTH_CLIENT_SECRET=xxx
DISCORD_BOT_TOKEN=xxx
TELEGRAM_BOT_TOKEN=xxx
