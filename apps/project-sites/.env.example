# projectsites.dev worker env — placeholders only, never commit real values.
# Secrets go via `wrangler secret put`. Bindings go in wrangler.toml.

# ── Cloudflare ────────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=xxx
CF_API_TOKEN=xxx
CF_ZONE_ID=xxx
CLOUDFLARE_API_KEY=xxx
CLOUDFLARE_EMAIL=you@example.com

# ── Database / Storage bindings (set in wrangler.toml, not .env) ─────────────
# DB=<D1 binding>
# SITES_BUCKET=<R2 binding>
# CACHE_KV=<KV binding>
# PROMPT_STORE=<KV binding>
# ANALYTICS=<Analytics Engine binding>
# QUEUE=<Queue binding>
# TRACE_HUB=<Queue binding>

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_ACCOUNT_ID=acct_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx
STRIPE_CONNECT_CLIENT_ID_TEST=ca_xxx
STRIPE_OAUTH_CLIENT_ID=ca_xxx
STRIPE_PRICE_ID_MONTHLY_WALLET=price_xxx
STRIPE_PRICE_CREDITS_100=price_xxx
STRIPE_PRICE_CREDITS_500=price_xxx
STRIPE_PRICE_CREDITS_2000=price_xxx
STRIPE_USAGE_PRICE_IDS=price_xxx

# ── Sale webhook (optional) ───────────────────────────────────────────────────
SALE_WEBHOOK_URL=https://example.com/webhook
SALE_WEBHOOK_SECRET=xxx
WEEKLY_DIGEST_SECRET=xxx

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
SENTRY_RELEASE=changeme
POSTHOG_API_KEY=phc_xxx
POSTHOG_PUBLIC_KEY=phc_xxx
POSTHOG_HOST=https://us.i.posthog.com
GA4_MEASUREMENT_ID=G-xxx
GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_JSON={}
