# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
SENDGRID_API_KEY=SG.xxx

# ── Novu (notifications) ──────────────────────────────────────────────────────
NOVU_API_KEY=xxx
NOVU_APP_ID=xxx
NOVU_SECRET_KEY=xxx
