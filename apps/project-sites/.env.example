# projectsites.dev worker env — placeholders only, never commit real values.
# Secrets go via `wrangler secret put`. Bindings go in wrangler.toml.

# ── Cloudflare ────────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=xxx
CF_API_TOKEN=xxx
CF_ZONE_ID=xxx
CLOUDFLARE_API_KEY=xxx
CLOUDFLARE_EMAIL=you@example.com

# ── Database / Storage bindings (set in wrangler.toml, not .env) ─────────────
# DB=<D1 binding>
# SITES_BUCKET=<R2 binding>
# CACHE_KV=<KV binding>
# PROMPT_STORE=<KV binding>
# ANALYTICS=<Analytics Engine binding>
# QUEUE=<Queue binding>
# TRACE_HUB=<Queue binding>

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_ACCOUNT_ID=acct_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx
STRIPE_CONNECT_CLIENT_ID_TEST=ca_xxx
STRIPE_OAUTH_CLIENT_ID=ca_xxx
STRIPE_PRICE_ID_MONTHLY_WALLET=price_xxx
STRIPE_PRICE_CREDITS_100=price_xxx
STRIPE_PRICE_CREDITS_500=price_xxx
STRIPE_PRICE_CREDITS_2000=price_xxx
STRIPE_USAGE_PRICE_IDS=price_xxx

# ── Sale webhook (optional) ───────────────────────────────────────────────────
SALE_WEBHOOK_URL=https://example.com/webhook
SALE_WEBHOOK_SECRET=xxx
WEEKLY_DIGEST_SECRET=xxx

# ── Observability ─────────────────────────────────────────────────────────────
POSTHOG_API_KEY=phc_xxx
POSTHOG_PUBLIC_KEY=phc_xxx
POSTHOG_HOST=https://us.i.posthog.com
GA4_MEASUREMENT_ID=G-xxx
GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_JSON={}
GTM_CONTAINER_ID=GTM-xxx
PLAUSIBLE_DOMAIN=projectsites.dev
CLARITY_PROJECT_ID=xxx
PAGERDUTY_OAUTH_CLIENT_ID=xxx
PAGERDUTY_ACCOUNT_SUBDOMAIN=xxx

# ── Abuse / Bot protection ────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=xxx
# Publishable key is safe to ship publicly — set in wrangler.toml [vars]
# TURNSTILE_SITE_KEY=xxx

# ── Auth / Internal ───────────────────────────────────────────────────────────
INTERNAL_BUILD_SECRET=changeme
INTERNAL_CALLBACK_URL=https://projectsites.dev/api/callback
MANIFEST_SIGNING_SECRET=changeme
MCP_ENCRYPTION_KEY=changeme
E2E_TEST_PASSWORD=changeme

# ── AI providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=xxx
GROQ_API_KEY=xxx
OPEN_ROUTER_API_KEY=xxx
REPLICATE_API_TOKEN=xxx

# ── AI Gateway (Cloudflare) ───────────────────────────────────────────────────
AI_GATEWAY_NAME=xxx
AI_GATEWAY_ENABLED=false

# ── Image generation ──────────────────────────────────────────────────────────
STABILITY_API_KEY=xxx
IDEOGRAM_API_KEY=xxx
RUNWAY_API_KEY=xxx
REMOVEBG_API_KEY=xxx
LOTTIEFILES_API_KEY=xxx
