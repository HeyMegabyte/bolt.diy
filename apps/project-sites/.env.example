PLAUSIBLE_DOMAIN=projectsites.dev
CLARITY_PROJECT_ID=xxx
PAGERDUTY_OAUTH_CLIENT_ID=xxx
PAGERDUTY_ACCOUNT_SUBDOMAIN=xxx

# ── Abuse / Bot protection ────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=xxx
# Publishable key is safe to ship publicly — set in wrangler.toml [vars]
# TURNSTILE_SITE_KEY=xxx

# ── Auth / Internal ───────────────────────────────────────────────────────────
INTERNAL_BUILD_SECRET=changeme
INTERNAL_CALLBACK_URL=https://projectsites.dev/api/callback
